# ==========================================================================
# Configuration de la plateforme IA documentaire
# Copier ce fichier en `.env` puis l'adapter :  cp .env.example .env
# Les chemins relatifs partent de la racine du projet.
# ==========================================================================

# ---- Modèle ----
# Identifiant HuggingFace du modèle
MODEL_NAME=TinyLlama/TinyLlama-1.1B-Chat-v1.0
# Dossier des poids convertis (vide = models/<MODEL_NAME>)
MODEL_PATH=
# Tokenizer séparé (vide = celui du modèle)
TOKENIZER_PATH=
# Télécharger le modèle automatiquement s'il manque
AUTO_DOWNLOAD=true
# Token HuggingFace pour les modèles privés ou protégés (Llama, Gemma...)
HF_TOKEN=

# ---- Matériel ----
# auto | cpu | cuda
DEVICE=auto
# Nombre de GPU
DEVICES=1
# Précision : vide = automatique, sinon bf16-true, 16-true, 32-true
PRECISION=
# Quantization (GPU + bitsandbytes) : vide, bnb.nf4, bnb.nf4-dq, bnb.fp4, bnb.int8
QUANTIZE=

# ---- Génération ----
MAX_NEW_TOKENS=256
TEMPERATURE=0.7
TOP_P=0.9
# Vide = désactivé
TOP_K=50
# Consigne envoyée au modèle avant chaque question (vide = aucune)
SYSTEM_PROMPT=Tu es un assistant spécialisé dans l'analyse de documents. Réponds de façon précise et claire.

# ---- Serveur ----
HOST=0.0.0.0
PORT=4444
# Origines autorisées si l'interface est servie depuis une autre adresse (séparées par des virgules)
CORS_ORIGINS=http://localhost:5555
MAX_PROMPT_LENGTH=8000
# Durée de conservation des réponses en mémoire (secondes)
RESULT_TTL_SECONDS=3600
LOG_LEVEL=INFO

# ---- Conversations ----
# Nombre de messages précédents envoyés au modèle comme contexte
CHAT_HISTORY_MESSAGES=6
# Longueur max du titre (début de la 1re question)
CHAT_TITLE_LENGTH=60

# ---- Dossiers de données (volumes Docker) ----
MODELS_DIR=models
CHECKPOINTS_DIR=checkpoints
DATASETS_DIR=datasets
DOCUMENTS_DIR=documents
LOGS_DIR=logs
# Base SQLite des conversations
STORAGE_DIR=storage
# Interface web construite (servie par le backend)
FRONTEND_DIR=frontend/dist

# ---- Docker : image publiée (GitHub Container Registry) ----
IMAGE_REGISTRY=ghcr.io/nibienvenu
# latest = dernière version de main, ou une version précise : 1.0.0
IMAGE_TAG=latest

# ---- Docker : ports publiés sur la machine (même conteneur) ----
# 4444 = API, 5555 = interface web
BACKEND_PORT=4444
FRONTEND_PORT=5555
